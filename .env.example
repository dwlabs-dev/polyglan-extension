# ngrok Auth Token
# Obtenha o seu em: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=seu_token_aqui

# WebSocket URL for student extension (session/presence)
VITE_WS_URL=ws://localhost:3001

# API URL for student extension
VITE_API_URL=http://localhost:3001

# OpenAI Whisper — used by the audio transcription pipeline
OPENAI_API_KEY=sk-...

# Polyglan API — where transcriptions are persisted
POLYGLAN_API_URL=https://api.polyglan.com
